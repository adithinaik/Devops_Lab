

pipeline {
    agent any

    stages {
        stage('Checkout from GitHub') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/adithinaik/Devops_Lab.git'
            }
        }

        stage('Verify Python') {
            steps {
                sh 'python3 --version'
            }
        }

        stage('Run Automated Tests') {
            steps {
                dir('Exercise-7-Jenkins-CI') {
                    sh 'python3 -m unittest -v test_app.py'
                }
            }
        }

        stage('Run Application') {
            steps {
                dir('Exercise-7-Jenkins-CI') {
                    sh 'python3 app.py'
                }
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Jenkins CI pipeline completed!'
        }
        failure {
            echo 'FAILED: Check Console Output for details.'
        }
    }
}
